#!/bin/sh
# minis-managed-clients-v1
set -eu
r=/opt/minis-clients/runtime-v1
loader="$r/lib/ld-musl-aarch64.so.1"
export SSL_CERT_FILE="$r/etc/ssl/certs/ca-certificates.crt"
export NODE_EXTRA_CA_CERTS="$SSL_CERT_FILE"
export ICU_DATA="$r/usr/share/icu/76.1"
export NODE_ICU_DATA="$ICU_DATA"
export GIT_EXEC_PATH="$r/usr/libexec/git-core"
export GIT_TEMPLATE_DIR="$r/usr/share/git-core/templates"
export LD_LIBRARY_PATH="$r/lib:$r/usr/lib"
case "${1:-}" in
  status) /usr/local/bin/opencode --version; /usr/local/bin/zcode --version; /usr/local/bin/node --version ;;

  opencode) shift; exec "$r/opencode" "$@" ;;
  zcode) shift
    export ZCODE_BUILTIN_PROVIDER_CONFIG_FILE="$r/zcode-builtin.json"
    export ZCODE_PERSONAL_PROVIDER_CONFIG_FILE="${ZCODE_PERSONAL_PROVIDER_CONFIG_FILE:-$HOME/.zcode/v2/provider_config.json}"
    mkdir -p "$HOME/.zcode/v2"
    exec "$loader" --library-path "$LD_LIBRARY_PATH" "$r/usr/bin/node" "$r/zcode.cjs" "$@" ;;
  node) shift; exec "$loader" --library-path "$LD_LIBRARY_PATH" "$r/usr/bin/node" "$@" ;;
  python3) shift; export PYTHONHOME="$r/usr"; exec "$loader" --library-path "$LD_LIBRARY_PATH" "$r/usr/bin/python3" "$@" ;;
  git) shift; exec "$loader" --library-path "$LD_LIBRARY_PATH" "$r/usr/bin/git" "$@" ;;
  *) echo 'Usage: minis-clients {status|opencode|zcode|node|python3|git} [arguments...]' >&2; exit 2 ;;
esac
